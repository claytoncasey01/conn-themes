{
  "id": "blueprint",
  "name": "Blueprint",
  "version": "1.0.0",
  "author": "conn",
  "license": "MIT",
  "description": "A drafting sheet: white grid lines on blueprint blue, bevelled cards with ruler ticks, a yellow marker accent, dimension-line wires with crawling dashes. Tokens only, no CSS.",
  "modes": ["dark"],
  "accent": "fixed",
  "fonts": ["IBM Plex Sans", "IBM Plex Mono"],
  "tokens": {
    "dark": {
      "bg": "#0c2846",
      "panel": "#113359",
      "raise": "#18426f",
      "sunk": "#0a2240",
      "hover": "rgba(207,227,255,.08)",
      "line": "rgba(207,227,255,.22)",
      "line2": "rgba(207,227,255,.5)",
      "tx": "#e4eeff",
      "bright": "#ffffff",
      "mu": "#a9c1df",
      "ac": "#ffd84a",
      "onac": "#1a1400",
      "edge": "#cfe3ff",
      "font-ui": "'IBM Plex Sans', ui-sans-serif, system-ui",
      "font-mono": "'IBM Plex Mono', ui-monospace",
      "case": "uppercase",
      "tracking": ".06em",
      "radius": "6px",
      "led": "square",
      "lift": "none",
      "glow": "0",
      "font-body": "ui",
      "backdrop": "grid",
      "backdrop-size": "24px",
      "backdrop-strength": "1",
      "orbs": "none",
      "header": "rule",
      "stage": "dots",
      "card-fill": "plain",
      "card-corner": "chamfer",
      "card-frame": "bold",
      "card-marks": "ticks",
      "card-stripe": "off",
      "card-rim": ".6",
      "card-shadow": "none",
      "glyph-arrow": "arrow",
      "glyph-bullet": "dash",
      "glyph-sep": "bar",
      "glyph-brand": "diamond",
      "stage-backing": "0",
      "node-beat": "off",
      "tree-orbits": "off",
      "wire-speed": ".6",
      "wire-signal": "roles",
      "wire-glyphs": "binary",
      "wire-flow": "pulse",
      "wire-crawl": "on",
      "wire-head": "arrow",
      "wire-width": "1px",
      "wire-style": "line",
      "card-cut": "12px",
      "meter": "segmented",
      "focus": "#ffd84a"
    }
  },
  "effects": []
}
