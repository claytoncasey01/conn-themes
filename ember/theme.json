{
  "id": "ember",
  "name": "Ember",
  "version": "1.0.0",
  "author": "conn",
  "license": "MIT",
  "description": "A banked fire: brown-black ground, amber light, rust chrome, and cooler smoke blue where status needs telling apart.",
  "modes": ["dark"],
  "accent": "fixed",
  "fonts": ["IBM Plex Sans", "JetBrains Mono"],
  "tokens": {
    "dark": {
      "bg": "oklch(.15 .014 52)",
      "panel": "oklch(.195 .017 52)",
      "raise": "oklch(.245 .02 52)",
      "sunk": "oklch(.12 .012 52)",
      "hover": "oklch(.225 .019 52)",
      "line": "oklch(.275 .022 50)",
      "line2": "oklch(.4 .045 48)",
      "tx": "oklch(.9 .022 80)",
      "bright": "oklch(.975 .014 85)",
      "mu": "oklch(.71 .034 68)",
      "ac": "oklch(.79 .16 66)",
      "onac": "oklch(.17 .035 52)",
      "ac-soft": "color-mix(in oklch, oklch(.79 .16 66) 13%, transparent)",
      "ac-line": "color-mix(in oklch, oklch(.79 .16 66) 45%, transparent)",
      "ok": "oklch(.78 .15 140)",
      "warn": "oklch(.89 .15 100)",
      "bad": "oklch(.68 .2 22)",
      "idle": "oklch(.6 .03 62)",
      "info": "oklch(.77 .095 235)",
      "k-bug": "oklch(.74 .16 15)",
      "k-epic": "oklch(.75 .12 305)",
      "k-task": "oklch(.77 .1 232)",
      "k-story": "oklch(.78 .13 140)",
      "k-subtask": "oklch(.78 .1 190)",
      "teammate": "oklch(.79 .12 350)",
      "role-lead": "oklch(.76 .15 48)",
      "role-agent": "oklch(.77 .09 215)",
      "role-advisor": "oklch(.76 .13 322)",
      "edge": "oklch(.6 .12 45)",
      "stall": "oklch(.69 .16 40)",
      "font-ui": "'IBM Plex Sans', ui-sans-serif, system-ui",
      "font-mono": "'JetBrains Mono', ui-monospace",
      "case": "none",
      "tracking": ".01em",
      "radius": "6px",
      "led": "diamond",
      "border-style": "solid",
      "lift": "0 14px 32px oklch(.05 .02 40/.55), inset 0 1px 0 oklch(.9 .08 70/.06)",
      "glow": "0",
      "blur": "0px",
      "motion": "calm"
    }
  },
  "effects": []
}
